{
  "name": "erickhar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:blog": "bun run --filter @erickhar/blog dev",
    "dev:dashboard": "bun run --filter @erickhar/dashboard dev",
    "build:blog": "bun run --filter @erickhar/blog build",
    "build:dashboard": "bun run --filter @erickhar/dashboard build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
